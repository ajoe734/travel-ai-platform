# ENG-09 deploy/runbook uses these values for the executable database baseline.
# Copy this file to a local, ignored `.env`; never commit credentials.  The
# current repository contains migrations and in-process services, not an HTTP
# server or a production connector worker.

# Required only for migration/DB verification.  This account needs the admin
# privileges documented in db/README.md; it is NOT the runtime app account.
DATABASE_URL=postgresql://CHANGE_ME@127.0.0.1:5432/travel_ai

# Required deployment declaration.  Only MOCK/SANDBOX are permitted for this
# repository's current connector implementation.  PRODUCTION requires the
# separately approved connector/account/operational-policy rollout.
TRAVEL_ENVIRONMENT=MOCK

# A non-secret identifier emitted by the future process/worker deployment.
# It is intentionally not an endpoint, API key, token, password, or DSN.
TRAVEL_DEPLOYMENT_ID=local-eng09
