{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.travel-ai-platform.invalid/domain/v1/work.schema.json",
  "title": "Work",
  "description": "ENG-01 new contract. Source: SD work-execution-contract.md §1-3, §7 與 ADR 0001. Work is the business responsibility accepted inside a Case; a Case commonly has multiple concurrent Works and each Work can own multiple ExecutionTasks. Work.status never overwrites Case.status (Case keeps its own container lifecycle, see case.schema.json).",
  "x_origin": {
    "status": "new_sd_contract",
    "version": "v1",
    "introduced": "ENG-01",
    "sa_trace": ["FR-25", "SM-01", "08.2"],
    "sd_trace": ["work-execution-contract.md §1-3,§7,§9"],
    "replaces_recovered_attachment": false
  },
  "$defs": {
    "WorkPlan": {
      "type": "object",
      "description": "SD §2: (tenant_id, work_id, plan_revision) unique, append-only. Enforcing append-only across the plan history is ENG-02 persistence scope; this shape fixes the single-revision contract.",
      "additionalProperties": false,
      "required": ["plan_revision", "steps", "planner_version"],
      "properties": {
        "plan_revision": { "type": "integer", "minimum": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_id", "description"],
            "properties": {
              "step_id": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "depends_on": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "planner_version": { "type": "string", "minLength": 1 },
        "context_refs": {
          "type": "array",
          "items": { "$ref": "common/identifiers.schema.json#/$defs/TenantScopedRef" }
        }
      }
    },
    "WorkContext": {
      "type": "object",
      "description": "SD §2: core order/quote/service references have a real FK, not a free-text string.",
      "additionalProperties": false,
      "required": ["ref_kind", "target", "purpose"],
      "properties": {
        "ref_kind": {
          "type": "string",
          "enum": ["ORDER", "QUOTE", "SERVICE_VERSION", "COMPLAINT", "PUBLICATION", "ASSET", "OTHER"]
        },
        "target": { "$ref": "common/identifiers.schema.json#/$defs/TenantScopedRef" },
        "target_revision": { "type": "integer", "minimum": 1 },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "CompletionEvidence": {
      "type": "object",
      "description": "SD §2/§7: immutable; references a verified external/source fact, not a chat transcript or an HTTP 200.",
      "additionalProperties": false,
      "required": ["tenant_id", "id", "work_id", "evidence_type", "environment", "external_ref", "observed_at", "verifier_version"],
      "properties": {
        "tenant_id": { "$ref": "common/identifiers.schema.json#/$defs/TenantId" },
        "id": { "$ref": "common/identifiers.schema.json#/$defs/Id" },
        "work_id": { "$ref": "common/identifiers.schema.json#/$defs/TenantScopedRef" },
        "task_id": {
          "$ref": "common/identifiers.schema.json#/$defs/TenantScopedRef",
          "description": "The ExecutionTask this evidence verifies. Optional: work-level evidence (e.g. a cross-task notification confirmation) may not belong to a single task."
        },
        "evidence_type": { "type": "string", "minLength": 1 },
        "source_account": { "type": "string" },
        "environment": { "type": "string", "enum": ["PRODUCTION", "SANDBOX", "MOCK"] },
        "external_ref": { "type": "string", "minLength": 1 },
        "source_revision": { "type": "string" },
        "observed_at": { "$ref": "common/identifiers.schema.json#/$defs/Timestamp" },
        "verified_at": { "$ref": "common/identifiers.schema.json#/$defs/Timestamp" },
        "payload_ref": { "type": "string" },
        "payload_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "verifier_version": { "type": "string", "minLength": 1 }
      }
    },
    "Escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "owner", "due_at", "status"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "common/identifiers.schema.json#/$defs/ActorRef" },
        "due_at": { "$ref": "common/identifiers.schema.json#/$defs/Timestamp" },
        "status": { "type": "string", "enum": ["OPEN", "RESOLVED"] },
        "resolution_ref": { "type": "string" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id", "id", "case_id", "work_type", "objective",
    "completion_contract_version", "completion_conditions", "principal",
    "status", "revision", "created_at", "updated_at"
  ],
  "properties": {
    "tenant_id": { "$ref": "common/identifiers.schema.json#/$defs/TenantId" },
    "id": { "$ref": "common/identifiers.schema.json#/$defs/Id" },
    "case_id": {
      "$ref": "common/identifiers.schema.json#/$defs/TenantScopedRef",
      "description": "SD §1: every merchant/customer Work must have exactly one primary case_id."
    },
    "work_type": { "type": "string", "pattern": "^[A-Z][A-Z_]*$" },
    "objective": { "type": "string", "minLength": 1 },
    "completion_contract_version": { "type": "string", "minLength": 1 },
    "completion_conditions": {
      "type": "array",
      "minItems": 1,
      "description": "Named, versioned postconditions (SD §1: 完成條件須通過具名 schema); never free text that a model could satisfy by rewording.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition_id", "description"],
        "properties": {
          "condition_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "satisfied": { "type": "boolean" },
          "evidence_ref": { "type": "string" }
        }
      }
    },
    "principal": { "$ref": "common/identifiers.schema.json#/$defs/ActorRef" },
    "authority_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_authorization_id": { "$ref": "common/identifiers.schema.json#/$defs/TenantScopedRef" }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT", "RUNNING", "WAITING_INPUT", "WAITING_DECISION", "WAITING_EXTERNAL",
        "VERIFYING", "PARTIAL", "COMPLETED", "FAILED", "CANCELLED"
      ],
      "description": "SD work-execution-contract.md §3."
    },
    "revision": { "$ref": "common/identifiers.schema.json#/$defs/Revision" },
    "plan": {
      "type": "array",
      "items": { "$ref": "#/$defs/WorkPlan" }
    },
    "context": {
      "type": "array",
      "items": { "$ref": "#/$defs/WorkContext" }
    },
    "execution_task_refs": {
      "type": "array",
      "description": "A Work commonly owns multiple ExecutionTasks (SD §1); this is a convenience projection, ExecutionTask.work_id is authoritative.",
      "items": { "$ref": "common/identifiers.schema.json#/$defs/TenantScopedRef" }
    },
    "completion_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/CompletionEvidence" }
    },
    "escalations": {
      "type": "array",
      "items": { "$ref": "#/$defs/Escalation" }
    },
    "waiting_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing_fields", "requested_from", "due_at"],
      "properties": {
        "missing_fields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "requested_from": { "$ref": "common/identifiers.schema.json#/$defs/ActorRef" },
        "due_at": { "$ref": "common/identifiers.schema.json#/$defs/Timestamp" }
      }
    },
    "waiting_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_ref"],
      "properties": {
        "decision_ref": { "$ref": "common/identifiers.schema.json#/$defs/TenantScopedRef" }
      }
    },
    "waiting_external": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_refs", "waiting_reason", "responsible"],
      "properties": {
        "task_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common/identifiers.schema.json#/$defs/TenantScopedRef" }
        },
        "waiting_reason": {
          "type": "string",
          "enum": ["KNOWN_PENDING", "RESULT_UNKNOWN"],
          "description": "ADR 0001: UNKNOWN 是 ExecutionTask 的不確定結果，Work 顯示 WAITING_EXTERNAL 加 RESULT_UNKNOWN 原因。"
        },
        "next_check_at": { "$ref": "common/identifiers.schema.json#/$defs/Timestamp" },
        "responsible": { "$ref": "common/identifiers.schema.json#/$defs/ActorRef" }
      }
    },
    "completion_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_refs", "verifier_version", "completed_at", "completion_contract_version"],
      "properties": {
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common/identifiers.schema.json#/$defs/TenantScopedRef" }
        },
        "verifier_version": { "type": "string", "minLength": 1 },
        "completed_at": { "$ref": "common/identifiers.schema.json#/$defs/Timestamp" },
        "completion_contract_version": { "type": "string", "minLength": 1 }
      }
    },
    "partial_summary": {
      "type": "object",
      "description": "SD §3: 每子項結果、未完成原因與接續責任；不表示全部已完成。",
      "additionalProperties": false,
      "required": ["completed_items", "incomplete_items", "as_of"],
      "properties": {
        "completed_items": {
          "type": "array",
          "minItems": 1,
          "description": "SD §3: PARTIAL requires at least one completed required sub-item; a Work with nothing finished is RUNNING/WAITING_*, not PARTIAL.",
          "items": { "type": "string" }
        },
        "incomplete_items": {
          "type": "array",
          "minItems": 1,
          "description": "SD §3: PARTIAL also requires at least one required sub-item still incomplete; if everything is done the Work is COMPLETED, not PARTIAL.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item", "reason"],
            "properties": {
              "item": { "type": "string" },
              "reason": { "type": "string" },
              "follow_up_work_ref": { "$ref": "common/identifiers.schema.json#/$defs/TenantScopedRef" }
            }
          }
        },
        "as_of": { "$ref": "common/identifiers.schema.json#/$defs/Timestamp" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "irreversible_effects_resolved"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "irreversible_effects_resolved": {
          "type": "boolean",
          "const": true,
          "description": "SD §3: 沒有未判定的不可逆副作用才能轉 FAILED. This object only exists on a Work already in status=FAILED (see allOf below), so by the time it is persisted the transition precondition must already hold; false here would mean the FAILED transition happened before resolution, which SD §3 forbids outright rather than allowing as a transient flag."
        },
        "compensation_or_escalation_ref": { "$ref": "common/identifiers.schema.json#/$defs/TenantScopedRef" }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "released_reservations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "created_at": { "$ref": "common/identifiers.schema.json#/$defs/Timestamp" },
    "updated_at": { "$ref": "common/identifiers.schema.json#/$defs/Timestamp" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "WAITING_INPUT" } }, "required": ["status"] }, "then": { "required": ["waiting_input"] }, "else": { "not": { "required": ["waiting_input"] } } },
    { "if": { "properties": { "status": { "const": "WAITING_DECISION" } }, "required": ["status"] }, "then": { "required": ["waiting_decision"] }, "else": { "not": { "required": ["waiting_decision"] } } },
    { "if": { "properties": { "status": { "const": "WAITING_EXTERNAL" } }, "required": ["status"] }, "then": { "required": ["waiting_external"] }, "else": { "not": { "required": ["waiting_external"] } } },
    { "if": { "properties": { "status": { "const": "COMPLETED" } }, "required": ["status"] }, "then": { "required": ["completion_record"] }, "else": { "not": { "required": ["completion_record"] } } },
    { "if": { "properties": { "status": { "const": "PARTIAL" } }, "required": ["status"] }, "then": { "required": ["partial_summary"] }, "else": { "not": { "required": ["partial_summary"] } } },
    { "if": { "properties": { "status": { "const": "FAILED" } }, "required": ["status"] }, "then": { "required": ["failure"] }, "else": { "not": { "required": ["failure"] } } },
    { "if": { "properties": { "status": { "const": "CANCELLED" } }, "required": ["status"] }, "then": { "required": ["cancellation"] }, "else": { "not": { "required": ["cancellation"] } } }
  ]
}
